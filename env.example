# ════════════════════════════════════════════════════════════════
# Hermes Agent — Secrets Reference (unencrypted template)
# ════════════════════════════════════════════════════════════════
#
#  ⚠  DO NOT PUT REAL KEYS HERE. This file is just a reference.
#
#  Secrets are managed with SOPS (sops-nix):
#    Encrypted:  secrets/hermes-env.sops.yaml  (committed to git)
#    Unencrypted reference:  config/.env.example  (this file)
#
#  To edit secrets:
#    ./scripts/edit-secrets.sh
#    (or: sops secrets/hermes-env.sops.yaml)
#
#  When you run `nix develop`, secrets are automatically decrypted
#  and loaded into your shell environment.
# ════════════════════════════════════════════════════════════════

# ── Required ───────────────────────────────────────────────────
# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-your-key-here

# ── Recommended ────────────────────────────────────────────────
# Firecrawl (web scraping — https://firecrawl.dev)
FIRECRAWL_API_KEY=fc-your-key-here

# FAL (image generation — https://fal.ai)
FAL_KEY=your-fal-key-here

# ElevenLabs (TTS — https://elevenlabs.io)
ELEVENLABS_API_KEY=your-elevenlabs-key-here

# ── Optional ───────────────────────────────────────────────────
# Anthropic API key (if using Anthropic directly)
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI API key (if using OpenAI directly)
# OPENAI_API_KEY=sk-your-key-here

# Google API key (if using Gemini)
# GOOGLE_API_KEY=your-google-key-here

# ── Model Overrides ────────────────────────────────────────────
# HERMES_MODEL=anthropic/claude-sonnet-4
# HERMES_PROVIDER=anthropic
# HERMES_PERSONALITY=technical

# ── Age Key Setup (for secret management) ──────────────────────
# Generate your age keypair:
#   mkdir -p ~/.config/sops/age
#   age-keygen -o ~/.config/sops/age/keys.txt
#   age-keygen -y ~/.config/sops/age/keys.txt   # share this public key
#
# Save to project (optional, for ./scripts/edit-secrets.sh):
#   cp ~/.config/sops/age/keys.txt secrets/.age-key
